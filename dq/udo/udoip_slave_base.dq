use ./udo       reexport
use ./udoslave  reexport
use ./udoip     reexport

struct SUdoIpRequest:
    srcip            : uint32  // source IP (IPv4)
    srcport          : uint16  // LSB format

    datalen          : uint16
    dataptr          : ^byte
endstruct

#ifndef UDOIP_ANSCACHE_NUM
const UDOIP_ANSCACHE_NUM : uint = 4  // this is also the parallel clients supported
// requires 6kByte RAM (= 4 * 1.5 k)
#endif

struct SUdoIpSlaveCache:
    idx              : byte
    _reserved        : byte
    srcport          : uint16

    srcip            : uint32

    rqh              : SUdoIpRqHeader

    datalen          : uint16  // data length with header
    dataptr          : ^byte
endstruct

object OUdoIpSlaveBase(OUdoSlaveBase):
public
    port             : uint16 = UDOIP_DEFAULT_PORT

public
    initialized      : bool = false

    miprq            : SUdoIpRequest
    mudorq           : SUdoRequest

    rqbuf            : ^byte = nil
    rqbufsize        : uint32 = 0

    ans_cache_lru_idx : [UDOIP_ANSCACHE_NUM] uint8
    ans_cache         : [UDOIP_ANSCACHE_NUM] SUdoIpSlaveCache

    last_request_mstime : uint32 = 0

    func *Create():
    endfunc

    func *Destroy():
    endfunc

    func Init() -> bool ..
    func Run() ..  // must be called regularly

public  // platform specific, these must be overridden

    func UdpInit() -> bool  [[virtual]]:
        return false
    endfunc

    func UdpRecv() -> int  [[virtual]]:  // into mcurq.
        return 0
    endfunc

    func UdpRespond(srcbuf : pointer, buflen : uint) -> int  [[virtual]]:
        return 0
    endfunc

    func MsCounter() -> uint32  [[virtual]]:  // This must be overridden !
        return 0
    endfunc

public
    func FindAnsCache(iprq : ref SUdoIpRequest, prqh : ref SUdoIpRqHeader) -> ^SUdoIpSlaveCache ..
    func AllocateAnsCache(iprq : ref SUdoIpRequest, prqh : ref SUdoIpRqHeader) -> ^SUdoIpSlaveCache ..

    func ProcessUdpRequest(ucrq : ref SUdoIpRequest) ..
endobject


implementation

// use a statically allocated buffer on bare metal
#ifdef BARE
  var udoip_rq_buffer        : [UDOIP_MAX_RQ_SIZE] byte
  var udoip_ans_cache_buffer : [UDOIP_ANSCACHE_NUM * UDOIP_MAX_RQ_SIZE] byte  // this might be relative big!
#endif

func OUdoIpSlaveBase.Init() -> bool:
    use *
    initialized = false

  #ifdef BARE  // use the statically allocated buffers
    rqbuf = %udoip_rq_buffer[0]
    rqbufsize = SizeOf(udoip_rq_buffer)
  #else // allocate on heap
    rqbufsize = UDOIP_MAX_RQ_SIZE
    rqbuf = ^byte(MemAlloc(rqbufsize))
  #endif

    // initialize the ans_cache

    var offs : uint32 = 0
    var n : uint = 0
    while n < UDOIP_ANSCACHE_NUM:
        MemSet(%ans_cache[n], 0, SizeOf(ans_cache[0]))
      #ifdef BARE  // use the statically allocated buffers
        ans_cache[n].dataptr = %udoip_ans_cache_buffer[offs]
      #else  // allocate on heap
        ans_cache[n].dataptr = ^byte(MemAlloc(UDOIP_MAX_RQ_SIZE))
      #endif
        ans_cache[n].idx = n
        offs += UDOIP_MAX_RQ_SIZE
        ans_cache_lru_idx[n] = n
        ++n
    endwhile

    if not UdpInit():
        return false
    endif

    // ok.

    initialized = true
    return true
endfunc

func OUdoIpSlaveBase.Run():
    // Receive client's message:
    var r : int = UdpRecv()  // fills the mcurq on success
    if r > 0:
        // something was received, mcurq is prepared

        ProcessUdpRequest(miprq)

        last_request_mstime = MsCounter()
    endif
endfunc

func OUdoIpSlaveBase.ProcessUdpRequest(ucrq : ref SUdoIpRequest):
    var r : int

    var prqh :? = ^SUdoIpRqHeader(ucrq.dataptr)

    #if false
        //TRACETS("UDP RQ: srcip=%s, port=%i, datalen=%i\n",
        //    inet_ntoa((struct in_addr *)^&ucrq.srcip), ucrq.srcport, ucrq.datalen)

        //TRACE("  sqid=%u, len_cmd=%u, address=%04X, offset=%u\n", prqh.rqid, prqh.len_cmd, prqh.index, prqh.offset)
    #endif

    // prepare the response

    // Check against the answer cache
    var pansc :? = FindAnsCache(ucrq, prqh^)
    if pansc <> nil:
        // TRACE(" (sending cached answer)\n");
        // send back the cached answer, avoid double execution
        r = UdpRespond(pansc.dataptr, pansc.datalen)
        if r <= 0:
            //TRACE("UdoIpSlave: error sending back the (cached) answer: %i!\r\n", r)
        endif
        return
    endif

    // allocate an answer cache record
    pansc = AllocateAnsCache(ucrq, prqh^)

    var pansh :? = ^SUdoIpRqHeader(pansc.dataptr)
    pansh^ = prqh^  // initialize the answer header with the request header
    var pansdata : ^byte = ^byte(pansh[1])  // the data comes right after the header

    // execute the UDO request

    @.MemSet(%mudorq, 0, SizeOf(mudorq))
    mudorq.index = prqh.index
    mudorq.offset = prqh.offset
    mudorq.rqlen = prqh.len_cmd & 0x7FF
    mudorq.maxanslen = mudorq.rqlen
    mudorq.iswrite = ((prqh.len_cmd >> 15) & 1) <> 0
    mudorq.metalen = (0x8420 >> ((prqh.len_cmd >> 13) & 3) * 4) & 0xF
    mudorq.metadata = prqh.metadata

    if mudorq.iswrite:
        // write
        mudorq.dataptr = ^uint8(prqh + 1)  // the data comes after the header
        mudorq.rqlen = ucrq.datalen - SizeOf(SUdoIpRqHeader)  // override the datalen from the header
    else:
        // read
        mudorq.dataptr = pansdata
    endif

    ParamReadWrite(mudorq)  // virtual function

    if mudorq.result <> 0:
        mudorq.anslen = 2
        pansh.len_cmd |= 0x7FF  // abort response
        ^uint16(pansdata)^ = mudorq.result
    endif

    pansc.datalen = mudorq.anslen + SizeOf(SUdoIpRqHeader)

    // send the response
    r = UdpRespond(pansc.dataptr, pansc.datalen)
    if r <= 0:
        //TRACE("UdoIpSlave: error sending back the answer: %i!\r\n", r)
    endif
endfunc


func OUdoIpSlaveBase.FindAnsCache(iprq : ref SUdoIpRequest, prqh : ref SUdoIpRqHeader) -> ^SUdoIpSlaveCache:
    use .
    var pac      : ^SUdoIpSlaveCache = %ans_cache[0]
    var last_pac : ^SUdoIpSlaveCache = pac + UDOIP_ANSCACHE_NUM
    while pac < last_pac:
        if pac.srcip == iprq.srcip  and pac.srcport == iprq.srcport
            and pac.rqh.rqid == prqh.rqid  and pac.rqh.len_cmd == prqh.len_cmd
            and pac.rqh.index == prqh.index  and pac.rqh.offset == prqh.offset
            and pac.datalen == iprq.datalen
        :
            // found the previous request, the response was probably lost
            return pac
        endif
        ++pac
    endwhile

    return nil
endfunc

func OUdoIpSlaveBase.AllocateAnsCache(iprq : ref SUdoIpRequest, prqh : ref SUdoIpRqHeader) -> ^SUdoIpSlaveCache:
    use *
    // re-use the oldest entry
    var idx : uint8 = ans_cache_lru_idx[0]  // the oldest entry
    MemCopy(%ans_cache_lru_idx[0], %ans_cache_lru_idx[1], UDOIP_ANSCACHE_NUM - 1)  // rotate the array
    ans_cache_lru_idx[UDOIP_ANSCACHE_NUM-1] = idx  // append to the end

    var pac : ^SUdoIpSlaveCache = %ans_cache[idx]
    pac.srcip   = iprq.srcip
    pac.srcport = iprq.srcport
    pac.rqh     = prqh
    return pac
endfunc

