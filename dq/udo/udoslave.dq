use ./udo

struct SUdoRequest:
    iswrite   : bool     // false: read
    metalen   : byte     // length of the metadata
    index     : uint16   // object index
    offset    : uint32
    metadata  : uint32

    rqlen     : uint16   // requested read/write length
    anslen    : uint16   // response data length, default = 0
    maxanslen : uint16   // maximal read buffer length
    error     : uint16   // 0 if no error

    dataptr   : ^byte

    func Error(aerror : uint16) -> bool [[inline]]:
        error = aerror
        return aerror == 0
    endfunc

    func Ok() -> bool [[inline]]:
        error = 0
        return true
    endfunc

    func RoInt(avalue : int32, len : uint32) -> bool ..
    func RoUint(avalue : uint32, len : uint32) -> bool ..
    func RoF32(avalue : float32) -> bool ..
    func RoF64(avalue : float64) -> bool ..

    func RwData(adataptr : pointer, adatalen : uint32) -> bool ..
    func RwDataZp(adataptr : pointer, adatalen : uint32) -> bool ..
    func RoData(adataptr : pointer, adatalen : uint32) -> bool ..
    func WoData(adataptr : pointer, adatalen : uint32) -> bool ..
    func RoStr(astr : strslice) -> bool ..

    func IntValue()  -> int32 ..
    func UintValue() -> uint32 ..
    func F32Value()  -> float32 ..
    func F64Value()  -> float64 ..
endstruct

func UdoSlaveHandleBaseObjects(udorq : ref SUdoRequest) -> bool ..

object OUdoSlave:

    // application specific handler
    func ParamReadWrite(rq : ref SUdoRequest) -> bool  [[virtual]]:
        return @.UdoSlaveHandleBaseObjects(rq)
    endfunc

endobject


implementation


func SUdoRequest.RoInt(avalue : int32, len : uint32) -> bool:
    if iswrite:
        error = UDOERR_READ_ONLY
        return false
    endif
    ^int32(dataptr)^ = avalue
    anslen = len
    error = 0
    return true
endfunc

func SUdoRequest.RoUint(avalue : uint32, len : uint32) -> bool:
    if iswrite:
        error = UDOERR_READ_ONLY
        return false
    endif
    ^uint32(dataptr)^ = avalue
    anslen = len
    error = 0
    return true
endfunc

func SUdoRequest.RoF32(avalue : float32) -> bool:
    if iswrite:
        error = UDOERR_READ_ONLY
        return false
    endif
    ^float32(dataptr)^ = avalue
    anslen = 4
    error = 0
    return true
endfunc

func SUdoRequest.RoF64(avalue : float64) -> bool:
    if iswrite:
        error = UDOERR_READ_ONLY
        return false
    endif
    ^float64(dataptr)^ = avalue
    anslen = 8
    error = 0
    return true
endfunc

func SUdoRequest.RwData(adataptr : pointer, adatalen : uint32) -> bool:
    if iswrite:
        // write, handling segmented write too

        // TRACE("udo_write(%04X, %u), len=%u\r\n", udorq->index, udorq->offset, udorq->datalen);

        if adatalen < offset + rqlen:
            error = UDOERR_WRITE_BOUNDS
            return false
        endif

        var cp :? = ^byte(adataptr)
        cp += offset

        var chunksize : uint32 = adatalen - offset  // the maximal possible chunksize
        if chunksize > rqlen:
            chunksize = rqlen
        endif
        @.MemCopy(cp, dataptr, chunksize)
    else:
        if adatalen <= offset:
            anslen = 0  // empty read: no more data
            return true
        endif

        var cp :? = ^byte(adataptr)
        cp += offset

        var remaining : uint = adatalen - offset  // already checked for negative case
        if remaining > maxanslen:
            anslen = maxanslen
        else:
            anslen = remaining
        endif
        @.MemCopy(dataptr, cp, anslen)
    endif
    error = 0
    return true
endfunc

func SUdoRequest.RwDataZp(adataptr : pointer, adatalen : uint32) -> bool:
    if iswrite:
        @.MemSet(dataptr, adatalen, 0)
    endif
    return RwData(adataptr, adatalen)
endfunc

func SUdoRequest.RoData(adataptr : pointer, adatalen : uint32) -> bool:
    if not iswrite:
        return RwData(adataptr, adatalen)
    endif
    error = UDOERR_READ_ONLY
    return false
endfunc

func SUdoRequest.WoData(adataptr : pointer, adatalen : uint32) -> bool:
    if iswrite:
        return RwData(adataptr, adatalen)
    endif
  	error = UDOERR_WRITE_ONLY
	return false
endfunc

func SUdoRequest.RoStr(astr : strslice) -> bool:
	return RoData(%astr[0], astr.length)
endfunc


func SUdoRequest.IntValue() -> int32:
    if   4 <= rqlen:  return ^int32(dataptr)^
    elif 2 == rqlen:  return ^int16(dataptr)^
    elif 3 == rqlen:  return ^int32(dataptr)^ & 0x00FFFFFF
    elif 0 == rqlen:  return 0
    else:
        return ^int8(dataptr)^
    endif
endfunc

func SUdoRequest.UintValue() -> uint32:
    if   4 <= rqlen:  return ^uint32(dataptr)^
    elif 2 == rqlen:  return ^uint16(dataptr)^
    elif 3 == rqlen:  return ^uint32(dataptr)^ & 0x00FFFFFF
    elif 0 == rqlen:  return 0
    else:
        return ^uint8(dataptr)^
    endif
endfunc

func SUdoRequest.F32Value() -> float32:
	  if rqlen >= SizeOf(float32):
        return ^float32(dataptr)^
    else:
        return 0
    endif
endfunc

func SUdoRequest.F64Value() -> float64:
	  if rqlen >= SizeOf(float64):
        return ^float64(dataptr)^
    else:
        return 0
    endif
endfunc

func UdoSlaveHandleBlobTest(udorq : ref SUdoRequest) -> bool: // object 0002
    // provide 16384 incrementing 32-bit integers

    var datalen : uint32 = 262144

    if udorq.offset & 3 <> 0:
        return udorq.Error(UDOERR_WRONG_OFFSET)
    endif

    udorq.rqlen = (udorq.rqlen + 3) & 0xFFFC  // force rqlen 4 divisible

    var v : uint32 = (udorq.offset >> 2)  // starting number

    if udorq.iswrite:
        if datalen < udorq.offset + udorq.rqlen:
            return udorq.Error(UDOERR_WRITE_BOUNDS)
        endif

        var sp   : ^uint32 = ^uint32(udorq.dataptr)
        var endp : ^uint32 = sp + (udorq.rqlen >> 2)
        while sp < endp:
            if sp^ <> v:
                return udorq.Error(UDOERR_WRITE_VALUE)
            endif
            ++sp
            ++v
        endwhile
    else:
        if datalen <= udorq.offset:
            udorq.anslen = 0  // empty read: no more data
            return true
        endif

        var remaining : uint = datalen - udorq.offset
        if remaining > udorq.maxanslen:
            udorq.anslen = udorq.maxanslen
        else:
            udorq.anslen = remaining
        endif

        var dp   : ^uint32 = ^uint32(udorq.dataptr)
        var endp : ^uint32 = dp + (udorq.anslen >> 2)
        while dp < endp:
            dp^ = v
            ++dp
            ++v
        endwhile
    endif

    udorq.error = 0
    return true
endfunc


func UdoSlaveHandleBaseObjects(udorq : ref SUdoRequest) -> bool:
    if   0x0000 == udorq.index: // communication test
        return udorq.RoUint(0x66CCAA55, 4)

    elif 0x0001 == udorq.index: // maximal payload length
        return udorq.RoUint(UDO_MAX_PAYLOAD_LEN, 4)

    elif 0x0002 == udorq.index: // blob test object
        return UdoSlaveHandleBlobTest(udorq)

    else:
        return udorq.Error(UDOERR_INDEX)
    endif
endfunc


