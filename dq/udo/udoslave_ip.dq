use ./udo
use ./udoslave
use nanonet/nano_sockets

const UDO_IP_DEFAULT_PORT      : uint16 = 1221
const UDO_SLAVE_ANSCACHE_COUNT : uint   = 8

struct SUdoIpRqHeader [[packed]]:
    rqid     : uint32   // request id to detect repeated requests
    len_cmd  : uint16   // LEN, MLEN, RW
    index    : uint16   // object index
    offset   : uint32
    metadata : uint32
endstruct

object OUdoDatagram(ONanoDatagram):
public
    func ProcessInData()  [[override]] ..
endobject

object OUdoIpSlaveBase ..

object OUdoAnsCacheItem:
public
    dg       : autofree OUdoDatagram
    rqheader : SUdoIpRqHeader

    func *Create(adg : OUdoDatagram):
        dg = adg
        rqheader.rqid   = 0xFFFFFFFF
        rqheader.index  = 0xFFFF
        rqheader.offset = 0xFFFFFFFF
    endfunc
endobject

object OUdoIpSlaveBase(ONanoUdpServer):
public
    anscache  : [*] autofree OUdoAnsCacheItem

    func *Create(alisten_port : uint16 = UDO_IP_DEFAULT_PORT) ..

    func ParamReadWrite(udorq : ref SUdoRequest) -> bool [[virtual]] ..

protected
    func FindCachedAnswer(rqdg : OUdoDatagram) -> OUdoAnsCacheItem ..
    func AllocateAnsCache(rqdg : OUdoDatagram) -> OUdoAnsCacheItem ..
endobject

implementation

