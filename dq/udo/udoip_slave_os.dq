
use ./udoip_slave_base   reexport

use nanonet/nano_sockets
use time

object OUdoDatagram(ONanoDatagram):
    func ProcessInData() [[override]] ..
endobject

object OUdpServerUdoIpSlave(ONanoUdpServer):
public
    udoip    : autofree OUdoIpSlave

    func *Create(audoslave : OUdoSlave, alisten_port : uint16 = UDOIP_DEFAULT_PORT):
        inherited Create(OUdoDatagram, alisten_port)
        udoip = new OUdoIpSlave(audoslave)
        udoip.Init()  // allocate internal structures
    endfunc
endobject

implementation

func OUdoDatagram.ProcessInData() [[override]]:
    var udpsvr :? = OUdpServerUdoIpSlave(server)

    var ucrq : SUdoIpRequest =
    {
        srcip:    remote_addr.sin_addr.s_addr,
        srcport:  remote_addr.sin_port,
        datalen:  rawdata_len,
        dataptr:  %rawdata[0]
    }

    var rspdata : ^byte = nil
    var rsplen  : uint16 = 0
    udpsvr.udoip.ProcessUdpRequest(ucrq, rspdata, rsplen)

    if rspdata <> nil  and rsplen > 0:
        SendResponse(rspdata, rsplen)
    endif
endfunc
